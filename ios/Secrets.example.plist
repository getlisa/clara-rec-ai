<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for image upload to S3.

  Copy to ClaraAssistant/Secrets.plist (gitignored) and fill in. Leave the file out entirely and
  the feature stays off — photos then never leave the phone.

  The IAM user behind these keys must be limited to s3:PutObject on this one bucket: anything in
  the app bundle is readable by anyone who unzips the IPA. See the README.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>S3_BUCKET</key>
	<string></string>
	<key>AWS_REGION</key>
	<string>us-east-1</string>
	<key>AWS_ACCESS_KEY_ID</key>
	<string></string>
	<key>AWS_SECRET_ACCESS_KEY</key>
	<string></string>
	<!-- Only for temporary STS credentials. -->
	<key>AWS_SESSION_TOKEN</key>
	<string></string>
</dict>
</plist>
