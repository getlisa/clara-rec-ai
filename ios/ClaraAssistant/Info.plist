<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Clara-Assistant</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Only standard HTTPS is used, which is exempt. Declaring it here avoids being asked
	     on every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Meta AI app calls back into the app on this scheme during glasses registration. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.justclara.ClaraAssistant</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>claraassistant</string>
			</array>
		</dict>
	</array>

	<!-- MetaAppID "0" selects developer mode, which needs no Wearables Developer Center app.
	     TeamID is still required so the SDK can verify the app against its signing team. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>claraassistant://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>

	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>

	<!-- No "processing" mode: it requires BGTaskSchedulerPermittedIdentifiers, and this app
	     schedules no background tasks. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>audio</string>
	</array>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Clara-Assistant connects to your Meta glasses over Bluetooth.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Clara-Assistant connects to your Meta glasses over Bluetooth.</string>

	<!-- The glasses are reached over the local network as well as Bluetooth. Without these
	     keys iOS blocks discovery and no device ever becomes eligible for a session. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This lets your phone find and connect to your glasses over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- Required even though the app never opens the phone camera itself: the Meta Wearables
	     SDK links camera APIs, and App Store validation rejects the build without a purpose
	     string (ITMS-90683). -->
	<key>NSCameraUsageDescription</key>
	<string>Clara-Assistant can use your phone's camera to simulate a glasses camera feed when no glasses are connected.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Clara-Assistant records audio alongside video from your glasses. When the glasses are connected, audio is captured from their microphone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Clara-Assistant saves your recordings to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Clara-Assistant shows the recordings it saved to your photo library.</string>
</dict>
</plist>
